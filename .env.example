# PostgreSQL de los METADATOS de Airflow (solo lo usa Airflow)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambia-esta-clave

# PostgreSQL del REPOSITORIO ANALÍTICO (destino del pipeline)
DW_DB=datamart_dw
DW_USER=datamart
DW_PASSWORD=cambia-esta-clave
DW_HOST_PORT=5435

# Usuario administrador de Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia-esta-clave

# Llave que cifra las contraseñas de las Connections. 
AIRFLOW_FERNET_KEY=pega-aqui-la-llave